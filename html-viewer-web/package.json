{
  "name": "html-viewer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "start": "swa start http://localhost:5173 --run \"npm run dev\" --api-devserver-url http://localhost:7071 --swa-config-location ./dev",
    "test:e2e": "playwright test",
    "e2e:serve": "npm run build && swa start dist --api-devserver-url http://localhost:7071 --swa-config-location ./dev --port 4281"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/static-web-apps-cli": "^2.0.10",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
